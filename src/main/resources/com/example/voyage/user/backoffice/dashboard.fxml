<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.voyage.user.backoffice.controllers.DashboardController"
            fx:id="mainContainer"
            prefHeight="768.0" prefWidth="1024.0">

    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>

    <!-- Top NavBar -->
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20" />
            </padding>
            
            <Label fx:id="pageTitle" styleClass="page-title" text="Dashboard" />
            
            <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="userNameLabel" styleClass="user-name" text="Welcome, Admin" />
                <Button styleClass="logout-button" onAction="#handleLogout">
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Logout" />
                    </tooltip>
                </Button>
            </HBox>
        </HBox>
    </top>
    
    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10" />
            </padding>
            
            <Label styleClass="sidebar-title" text="VOYAGE ADMIN" />
            
            <Separator styleClass="sidebar-separator" />
            
            <Button fx:id="usersButton" styleClass="sidebar-button" onAction="#handleUsersButton">
                <graphic>
                    <FontIcon iconLiteral="fas-users" iconSize="18" />
                </graphic>
                <Label text="Users" />
            </Button>
            
            <Button fx:id="voyagesButton" styleClass="sidebar-button" onAction="#handleVoyagesButton">
                <graphic>
                    <FontIcon iconLiteral="fas-plane" iconSize="18" />
                </graphic>
                <Label text="Voyages" />
            </Button>
            
            <Button fx:id="guidesButton" styleClass="sidebar-button" onAction="#handleGuidesButton">
                <graphic>
                    <FontIcon iconLiteral="fas-user-tie" iconSize="18" />
                </graphic>
                <Label text="Guides" />
            </Button>
            
            <Button fx:id="bookingsButton" styleClass="sidebar-button" onAction="#handleBookingsButton">
                <graphic>
                    <FontIcon iconLiteral="fas-calendar-check" iconSize="18" />
                </graphic>
                <Label text="Bookings" />
            </Button>
            
            <!-- New Statistics Buttons -->
            <Label text="ANALYTICS" styleClass="section-label" />
            
            <Button fx:id="userBookingsStatsButton" text="Booking Analytics" styleClass="stat-button" onAction="#handleUserBookingsStats">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-bar" iconSize="16"/>
                </graphic>
            </Button>
            
            <Button fx:id="voyageStatsButton" text="Voyage Analytics" styleClass="stat-button" onAction="#handleVoyageStats">
                <graphic>
                    <FontIcon iconLiteral="fas-chart-line" iconSize="16"/>
                </graphic>
            </Button>
        </VBox>
    </left>
    
    <!-- Main Content Area -->
    <center>
        <VBox fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>
            
            <!-- Content will be loaded dynamically here -->
            <Label styleClass="welcome-text" text="Welcome to Voyage Admin Dashboard" />
            <Label styleClass="info-text" text="Select an option from the sidebar to get started" />
        </VBox>
    </center>
</BorderPane>
