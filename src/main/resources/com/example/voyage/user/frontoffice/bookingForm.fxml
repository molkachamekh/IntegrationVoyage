<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.voyage.user.frontoffice.controllers.BookingFormController"
      spacing="15" styleClass="booking-form-container"
      prefWidth="500" prefHeight="500" alignment="CENTER">

    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>
    
    <padding>
        <Insets top="25" right="25" bottom="25" left="25" />
    </padding>
    
    <Label styleClass="form-title" text="Book Your Voyage" />
    
    <!-- Voyage Details Section -->
    <VBox spacing="10" styleClass="form-section">
        <Label styleClass="section-title" text="Voyage Details" />
        
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="100" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            
            <Label text="Destination:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="destinationLabel" styleClass="form-value-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="Departure Date:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="departureDateLabel" styleClass="form-value-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Return Date:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="returnDateLabel" styleClass="form-value-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <Label text="Price:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="priceLabel" styleClass="price-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="3" />
        </GridPane>
    </VBox>
    
    <Separator />
    
    <!-- Traveler Information -->
    <VBox spacing="10" styleClass="form-section">
        <Label styleClass="section-title" text="Traveler Information" />
        
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="100" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            
            <Label text="Full Name:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="fullNameLabel" styleClass="form-value-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="Email:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="emailLabel" styleClass="form-value-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Phone:" styleClass="form-label" 
                  GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="phoneLabel" styleClass="form-value-label"
                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </GridPane>
    </VBox>
    
    <Separator />
    
    <!-- Special Requests -->
    <VBox spacing="10" styleClass="form-section">
        <Label styleClass="section-title" text="Special Requests (Optional)" />
        
        <TextArea fx:id="specialRequestsField" styleClass="form-textarea" 
                 promptText="Enter any special requests or requirements here..." 
                 wrapText="true" prefRowCount="3" />
    </VBox>
    
    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" styleClass="cancel-button" 
               onAction="#handleCancel" />
        <Button fx:id="confirmBookingButton" text="Confirm Booking" styleClass="primary-button" 
               onAction="#handleConfirmBooking">
            <graphic>
                <FontIcon iconLiteral="fas-check-circle" iconSize="16" />
            </graphic>
        </Button>
    </HBox>
    
    <Label fx:id="errorLabel" styleClass="error-label" visible="false" />
</VBox>
