<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.voyage.voyage.frontoffice.controllers.ExploreContentController"
            styleClass="content-pane">

    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>
    
    <top>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20" />
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="Explore Voyages" styleClass="content-header"/>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="totalVoyagesLabel" styleClass="subtitle-text" text="0 voyages available"/>
            </HBox>
            
            <!-- Search & Filter controls -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <HBox HBox.hgrow="ALWAYS" styleClass="search-container">
                    <FontIcon iconLiteral="fas-search" iconSize="16" styleClass="search-icon"/>
                    <TextField fx:id="searchField" promptText="Search destinations..." HBox.hgrow="ALWAYS" styleClass="search-field" />
                </HBox>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="Sort by:" />
                    <ComboBox fx:id="sortComboBox" prefWidth="180" />
                    
                    <Button fx:id="filterButton" styleClass="filter-button">
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <FontIcon iconLiteral="fas-filter" iconSize="14"/>
                                <Label text="Filters" />
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>
        </VBox>
    </top>
    
    <center>
        <!-- Voyages Container -->
        <ScrollPane fx:id="scrollPane" styleClass="content-scroll-pane" fitToWidth="true">
            <FlowPane fx:id="voyagesContainer" hgap="30" vgap="30" prefWrapLength="1000"/>
        </ScrollPane>
    </center>
</BorderPane>
