<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.voyage.voyage.frontoffice.controllers.HomeContentController"
      spacing="20" styleClass="content-pane" alignment="TOP_CENTER">

    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- Welcome Banner -->
    <VBox styleClass="welcome-banner" alignment="CENTER">
        <padding>
            <Insets top="30" right="20" bottom="30" left="20" />
        </padding>
        
        <Label text="Discover Amazing Destinations" styleClass="welcome-title"/>
        <Label text="Find and book your perfect getaway" styleClass="welcome-subtitle"/>
    </VBox>
    
    <!-- Quick Stats Section -->
    <HBox spacing="20" alignment="CENTER" maxHeight="150" VBox.vgrow="NEVER">
        <VBox styleClass="stat-box" alignment="CENTER">
            <FontIcon iconLiteral="fas-globe" iconSize="32"/>
            <Label text="25+" styleClass="stat-number"/>
            <Label text="Destinations" styleClass="stat-label"/>
        </VBox>
        
        <VBox styleClass="stat-box" alignment="CENTER">
            <FontIcon iconLiteral="fas-users" iconSize="32"/>
            <Label text="10K+" styleClass="stat-number"/>
            <Label text="Happy Customers" styleClass="stat-label"/>
        </VBox>
        
        <VBox styleClass="stat-box" alignment="CENTER">
            <FontIcon iconLiteral="fas-star" iconSize="32"/>
            <Label text="4.9" styleClass="stat-number"/>
            <Label text="Customer Rating" styleClass="stat-label"/>
        </VBox>
    </HBox>

    <!-- Featured destinations section -->
    <VBox alignment="CENTER" VBox.vgrow="ALWAYS" styleClass="featured-section">
        <Label text="Popular Destinations" styleClass="section-title"/>
        
        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" styleClass="feature-item">
                <StackPane styleClass="feature-image-container">
                    <Rectangle width="200" height="150" styleClass="feature-image-placeholder"/>
                    <Label text="Paris" styleClass="feature-name"/>
                </StackPane>
            </VBox>
            
            <VBox alignment="CENTER" styleClass="feature-item">
                <StackPane styleClass="feature-image-container">
                    <Rectangle width="200" height="150" styleClass="feature-image-placeholder"/>
                    <Label text="Bali" styleClass="feature-name"/>
                </StackPane>
            </VBox>
            
            <VBox alignment="CENTER" styleClass="feature-item">
                <StackPane styleClass="feature-image-container">
                    <Rectangle width="200" height="150" styleClass="feature-image-placeholder"/>
                    <Label text="Tokyo" styleClass="feature-name"/>
                </StackPane>
            </VBox>
        </HBox>
    </VBox>
    
    <!-- Call to Action -->
    <VBox styleClass="cta-box" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
        </padding>
        
        <Label text="Ready for your next adventure?" styleClass="cta-title"/>
        <Button fx:id="exploreButton" text="Explore Voyages" styleClass="cta-button" onAction="#handleExploreVoyages">
            <graphic>
                <FontIcon iconLiteral="fas-search" iconSize="16"/>
            </graphic>
        </Button>
    </VBox>
</VBox>
