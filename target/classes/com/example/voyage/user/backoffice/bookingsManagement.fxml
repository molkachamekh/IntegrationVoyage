<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.voyage.user.backoffice.controllers.BookingsManagementController"
      spacing="15" styleClass="content-container">
      
    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>
    
    <padding>
        <Insets top="15" right="20" bottom="20" left="20" />
    </padding>
    
    <!-- Search and Actions Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10">
            <FontIcon iconLiteral="fas-search" iconSize="16" />
            <TextField fx:id="searchField" promptText="Search bookings..." prefWidth="300" />
        </HBox>
        
        <Button fx:id="addBookingButton" styleClass="primary-button" onAction="#handleAddBooking">
            <graphic>
                <FontIcon iconLiteral="fas-calendar-plus" iconSize="16" />
            </graphic>
            <Label text="Add Booking" />
        </Button>
    </HBox>
    
    <!-- Bookings Table -->
    <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
            <TableColumn fx:id="userColumn" text="User" prefWidth="150" />
            <TableColumn fx:id="voyageColumn" text="Voyage" prefWidth="200" />
            <TableColumn fx:id="bookingDateColumn" text="Booking Date" prefWidth="150" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
        </columns>
        <placeholder>
            <Label text="No bookings available" />
        </placeholder>
    </TableView>
    
    <!-- Row Actions -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="editBookingButton" styleClass="secondary-button" onAction="#handleEditBooking">
            <graphic>
                <FontIcon iconLiteral="fas-edit" iconSize="16" />
            </graphic>
            <Label text="Edit" />
        </Button>
        <Button fx:id="deleteBookingButton" styleClass="cancel-button" onAction="#handleDeleteBooking">
            <graphic>
                <FontIcon iconLiteral="fas-trash-alt" iconSize="16" />
            </graphic>
            <Label text="Delete" />
        </Button>
    </HBox>
</VBox>
