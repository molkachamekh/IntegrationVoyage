<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.voyage.user.backoffice.controllers.UserFormController"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">

    <VBox styleClass="form-container" spacing="20" alignment="TOP_CENTER">
        <stylesheets>
            <URL value="@../../css/styles.css" />
        </stylesheets>
        
        <padding>
            <Insets top="20" right="30" bottom="20" left="30" />
        </padding>
        
        <Label text="User Information" styleClass="form-title" />
        
        <GridPane fx:id="formGrid" vgap="10" hgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
            </columnConstraints>
            
            <!-- Username Field -->
            <Label text="Username *" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="usernameField" promptText="Enter username" 
                      GridPane.rowIndex="0" GridPane.columnIndex="1" />
            
            <!-- Password Field -->
            <Label text="Password *" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <PasswordField fx:id="passwordField" promptText="Enter password" 
                         GridPane.rowIndex="2" GridPane.columnIndex="1" />
            
            <!-- Confirm Password Field -->
            <Label text="Confirm Password *" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" 
                         GridPane.rowIndex="4" GridPane.columnIndex="1" />
            
            <!-- Email Field -->
            <Label text="Email *" GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <TextField fx:id="emailField" promptText="Enter email address" 
                      GridPane.rowIndex="6" GridPane.columnIndex="1" />
            
            <!-- Full Name Field -->
            <Label text="Full Name *" GridPane.rowIndex="8" GridPane.columnIndex="0" />
            <TextField fx:id="fullNameField" promptText="Enter full name" 
                      GridPane.rowIndex="8" GridPane.columnIndex="1" />
            
            <!-- Date of Birth Field -->
            <Label text="Date of Birth" GridPane.rowIndex="10" GridPane.columnIndex="0" />
            <DatePicker fx:id="datePicker" promptText="Select date of birth" 
                      GridPane.rowIndex="10" GridPane.columnIndex="1" />
            
            <!-- Phone Number Field -->
            <Label text="Phone Number" GridPane.rowIndex="12" GridPane.columnIndex="0" />
            <TextField fx:id="phoneField" promptText="Enter phone number" 
                      GridPane.rowIndex="12" GridPane.columnIndex="1" />
            
            <!-- Admin Checkbox -->
            <Label text="Role" GridPane.rowIndex="14" GridPane.columnIndex="0" />
            <CheckBox fx:id="adminCheckBox" text="Administrator" 
                    GridPane.rowIndex="14" GridPane.columnIndex="1" />
        </GridPane>
        
        <!-- Form Actions -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="20" />
            </padding>
            <Label text="* Required fields" styleClass="hint-text" HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" />
            <Button fx:id="saveButton" text="Save" styleClass="primary-button" onAction="#handleSave" />
        </HBox>
    </VBox>
</ScrollPane>
